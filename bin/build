#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build"

if command -v qmake6 >/dev/null 2>&1; then
  QMAKE=qmake6
elif command -v qmake >/dev/null 2>&1 && qmake -query QT_VERSION | grep -q '^6\.'; then
  QMAKE=qmake
else
  echo "A Qt 6 qmake (qmake6) is required to build omapass." >&2
  exit 1
fi

if ! command -v cmake >/dev/null 2>&1; then
  echo "cmake is required to build the vendored keepassxc-cli." >&2
  exit 1
fi

JOBS="$(nproc 2>/dev/null || echo 1)"

# qmake's Makefiles do not list Qt's own headers as dependencies, so after a
# Qt (or compiler) upgrade `make` keeps object files built against the old
# headers and links them with fresh ones. Inline template code from the two
# versions then meets in one binary, and it crashed in filterItems. Start
# over whenever the toolchain changes.
toolchain="$("$QMAKE" -query QT_VERSION) $("$QMAKE" -query QT_INSTALL_HEADERS) $("${CXX:-g++}" --version 2>/dev/null | head -n 1)"
if [ -d "$BUILD_DIR" ] && [ "$(cat "$BUILD_DIR/.toolchain" 2>/dev/null)" != "$toolchain" ]; then
  echo "Qt or compiler changed since the last build; rebuilding $BUILD_DIR from scratch." >&2
  rm -rf "$BUILD_DIR"
fi
mkdir -p "$BUILD_DIR"
printf '%s\n' "$toolchain" > "$BUILD_DIR/.toolchain"

if [ ! -f "$ROOT/vendor/keepassxc/CMakeLists.txt" ]; then
  git -C "$ROOT" submodule update --init vendor/keepassxc
fi

KEEPASSXC_CLI_BUILD_DIR="$BUILD_DIR/vendor-keepassxc"
cmake -S "$ROOT/vendor/keepassxc" -B "$KEEPASSXC_CLI_BUILD_DIR" \
  -DKPXC_CLI_ONLY=ON -DCMAKE_BUILD_TYPE=Release -DWITH_TESTS=OFF -DKPXC_FEATURE_DOCS=OFF
cmake --build "$KEEPASSXC_CLI_BUILD_DIR" -j"$JOBS" --target keepassxc-cli

mkdir -p "$BUILD_DIR"
cp "$KEEPASSXC_CLI_BUILD_DIR/src/cli/keepassxc-cli" "$BUILD_DIR/keepassxc-cli"

cd "$BUILD_DIR"

"$QMAKE" "$ROOT/omapass.pro"
make -j"$JOBS"

echo "Built $BUILD_DIR/omapass and $BUILD_DIR/keepassxc-cli"
