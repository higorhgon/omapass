#!/bin/sh
# Entry point of the AppImage. It exists to put the tools that travel inside
# the package ahead on PATH — the `keepassxc-cli` omapass builds — before
# handing over.
#
# The other backends' CLIs are deliberately not bundled: `bw`, `op`, `gpg`
# and `pass` hold your accounts and keys, are updated on their own schedule,
# and belong to the system. `omapass --doctor` says which ones it found.
HERE="$(dirname "$(readlink -f "$0")")"
export PATH="$HERE/usr/bin:$PATH"
exec "$HERE/usr/bin/omapass" "$@"
