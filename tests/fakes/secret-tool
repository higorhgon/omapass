#!/bin/sh
# Stand-in for libsecret's `secret-tool`, so the PIN store can be tested
# without a keyring daemon or a desktop session.
#
# Each set of attributes is one file in SECRET_TOOL_FAKE_DIR, named after a
# digest of the attributes; `store` reads the secret from stdin as the real
# one does. Every command line is appended to argv.log, which is how the
# tests check that no secret ever travelled as an argument.

dir="${SECRET_TOOL_FAKE_DIR:?}"
printf '%s\n' "$*" >> "$dir/argv.log"

command="$1"
shift
if [ "$command" = store ] && [ "$1" = --label ]; then
    shift 2
fi
key=$(printf '%s\n' "$@" | sha256sum | cut -d' ' -f1)

case "$command" in
    store) cat > "$dir/$key" ;;
    lookup) [ -f "$dir/$key" ] || exit 1; cat "$dir/$key" ;;
    clear) rm -f "$dir/$key" ;;
    *) echo "secret-tool (fake): unknown command $command" >&2; exit 2 ;;
esac
